{
  "name": "tallypad",
  "version": "0.1.0",
  "description": "Local notepad-style calculator",
  "type": "module",
  "main": "src/main.js",
  "author": "Billy Coover",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "test:e2e": "node --test e2e/smoke.e2e.mjs",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:mac": "electron-builder --mac dmg",
    "dist:win": "electron-builder --win nsis"
  },
  "build": {
    "appId": "app.tallypad",
    "productName": "TallyPad",
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "playwright": "^1.62.1"
  }
}
